{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "vitest.config.mts",
    "src/core/**/*",
    "src/data/**/*",
    "scripts/simulate/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "baseUrl": ".",
    "paths": {
      "@core": [
        "src/core/index.ts"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@data": [
        "src/data/index.ts"
      ]
    }
  }
}
